# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Telegram salary intake (the bot turns deposit screenshots into incomes)
# Bot token from @BotFather: validates the Mini App's initData and authorizes every Bot API call; without it the bot cannot reply
TELEGRAM_BOT_TOKEN=
# Claude API key for reading screenshots; when unset the bot asks for a typed amount instead
ANTHROPIC_API_KEY=
# Webhook secret: generate with `openssl rand -hex 32`; must match setWebhook's secret_token
TELEGRAM_WEBHOOK_SECRET=
# Screenshot reads allowed per user in any rolling hour
SALARY_INTAKE_USER_HOURLY=10
# Screenshot reads allowed per user in any rolling 24 hours
SALARY_INTAKE_USER_DAILY=30
# Screenshot reads allowed across all users in any rolling 24 hours
SALARY_INTAKE_DAILY_LIMIT=200
